# Copy to .env and fill in. `docker compose up` reads .env automatically.
#
#   cp .env.example .env
#
# Only JWT_SECRET is mandatory — compose refuses to start without it. The rest are
# credentials for real external services; the stack boots without them, but uploads
# (Cloudinary) and outbound email (Gmail) will fail at the point of use.

# REQUIRED. Signs the 15-minute access tokens. Generate a real one:
#   openssl rand -hex 32
JWT_SECRET=

# media-service -> Cloudinary. Note the variable is CLOUD_NAME, not CLOUDINARY_CLOUD_NAME.
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# notification-service -> Gmail SMTP. EMAIL_APP_PASSWORD is a Google App Password,
# not your account password.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- live testing only (scripts/live-test.mjs) ---
# Three real inboxes you control. Team 1 hosts, team 2 gets accepted,
# team 3 gets rejected.
TEST_EMAIL_1=
TEST_EMAIL_2=
TEST_EMAIL_3=
# Leave SMTP_HOST BLANK to send via real Gmail. Set it to `mailpit` to go
# back to the local sink used by the automated smoke test.
SMTP_HOST=

# Shared secret the gateway injects and downstream services verify. REQUIRED when the
# services have public URLs (e.g. Render); optional on compose where they are unreachable.
#   openssl rand -hex 32
INTERNAL_SECRET=
