# Copy to .env and fill in. `docker compose up` reads .env automatically.
#
#   cp .env.example .env
#
# Only JWT_SECRET is mandatory — compose refuses to start without it. The rest are
# credentials for real external services; the stack boots without them, but uploads
# (Cloudinary) and outbound email (Gmail) will fail at the point of use.

# REQUIRED. Signs the 15-minute access tokens. Generate a real one:
#   openssl rand -hex 32
JWT_SECRET=

# media-service -> Cloudinary. Note the variable is CLOUD_NAME, not CLOUDINARY_CLOUD_NAME.
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# notification-service -> Gmail SMTP. EMAIL_APP_PASSWORD is a Google App Password,
# not your account password.
EMAIL_USER=
EMAIL_APP_PASSWORD=
